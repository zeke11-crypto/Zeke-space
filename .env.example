# Required — get a free key at https://twitterapi.io (no card needed to start,
# trial credits included; ~$0.00015 per tweet returned after that).
TWITTERAPI_IO_KEY=

# Optional — if set, natural-language searches are converted to search
# operators by Claude Haiku (fractions of a cent per query). If left blank,
# a free built-in keyword parser is used instead — the app works either way.
ANTHROPIC_API_KEY=
